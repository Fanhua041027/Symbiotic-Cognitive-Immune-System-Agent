# ============================================================================
# Symbiotic Cognitive Immune System Agent — Configuration
# ============================================================================

# LLM Provider: openai / deepseek / custom
#   openai   → uses OPENAI_API_KEY and api.openai.com
#   deepseek → uses DEEPSEEK_API_KEY and api.deepseek.com
#   custom   → uses CUSTOM_API_KEY + CUSTOM_API_BASE
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepSeek (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Custom OpenAI-compatible endpoint (used when LLM_PROVIDER=custom)
CUSTOM_API_KEY=sk-your-custom-api-key-here
CUSTOM_API_BASE=https://your-custom-endpoint/v1

# LLM 模型选择（按 provider 不同使用对应模型名）
#   openai:    gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
#   deepseek:  deepseek-chat, deepseek-reasoner
#   custom:    取决于你的端点
MAIN_LLM_MODEL=gpt-4o
MONITOR_LLM_MODEL=gpt-4o-mini
ANTIBODY_LLM_MODEL=gpt-4o

# LLM 温度参数
LLM_TEMPERATURE=0.7

# 最大免疫迭代次数（防止无限修复循环）
MAX_ITERATIONS=5

# 沙箱验证模式: simulated / ast / docker / e2b
SANDBOX_MODE=simulated

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 告警升级阈值（连续失败次数达到后通知人类）
ESCALATION_THRESHOLD=3

# Session 管理（长时间运行的自愈 Agent）
#   SESSION_MAX_TURNS: 最大记录轮数（达到后自动淘汰最旧记录）
SESSION_MAX_TURNS=500

# FastAPI server configuration (used by api.py)
API_PORT=8000
API_HOST=0.0.0.0

# Rate limiting for API (used by api.py via core/ratelimit.py)
#   RATE_LIMIT_REQUESTS: 每个时间窗口内允许的最大请求数（留空则禁用限流）
#   RATE_LIMIT_WINDOW:   时间窗口大小（秒）
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Notification channels (v1.2.0)
#   Slack webhook URL for escalation alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
#   Generic webhook URL for JSON payloads
# NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint
