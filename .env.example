# OpenAI API 配置
OPENAI_API_KEY=sk-your-api-key-here

# LLM 模型选择（可按需调整）
MAIN_LLM_MODEL=gpt-4o
MONITOR_LLM_MODEL=gpt-4o-mini
ANTIBODY_LLM_MODEL=gpt-4o

# LLM 温度参数
LLM_TEMPERATURE=0.7

# 最大免疫迭代次数（防止无限修复循环）
MAX_ITERATIONS=5

# 沙箱验证模式: simulated / ast / docker
SANDBOX_MODE=simulated

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 告警升级阈值（连续失败次数达到后通知人类）
ESCALATION_THRESHOLD=3
